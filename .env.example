# ─────────────────────────────────────────────────────────────────────────────
# PYQPB BACKEND — ENVIRONMENT VARIABLES REFERENCE (.env.example)
# Copy to .env and fill in your values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# ─── Database ─────────────────────────────────────────────────────────────────
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/pyqpb
# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/pyqpb?retryWrites=true&w=majority

# ─── Redis (optional) ─────────────────────────────────────────────────────────
# Leave ALL Redis vars commented out for local dev without Redis.
# Uncomment only when Redis is actually running.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=change_this_to_another_random_64_char_string
JWT_REFRESH_EXPIRE=30d
JWT_COOKIE_EXPIRE=7

# ─── Email ────────────────────────────────────────────────────────────────────
# Leave SMTP_USER and SMTP_PASS blank to disable email (safe for local dev).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@pyqpb.com
FROM_NAME=PYQPB

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Use rzp_test_ keys for development — NEVER use rzp_live_ locally
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Local dev (Vite default port):
FRONTEND_URL=http://localhost:5173
# Production (comma-separated, no spaces):
# FRONTEND_URL=https://pyqpb.com,https://www.pyqpb.com
